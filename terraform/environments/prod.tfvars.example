# Production environment example.
# Use a separate backend key/state from development. Do not use dev IDs,
# endpoints, or secret ARNs here.

aws_region  = "il-central-1"
project     = "yinon-status-page"
environment = "prod"
owner       = "yinon"

# Enable the reviewed production topology. Runtime database and Redis endpoints,
# and the RDS-managed password secret ARN, are derived by Terraform.
create_network    = true
create_data_plane = true
create_services   = true
enable_monitoring = true
create_alert_topic = false
enable_aws_budget  = false

# The non-secret relay URL is injected from the private integrations file by
# production_apply.sh. Keep external receiver configuration out of source.
alert_https_endpoints = []

# An administrator-created exact topic can unlock notification delivery without
# granting this operator SNS administration. Keep null until its policy is verified.
external_alert_topic_arn = null

image_tag = "sha-REPLACE_WITH_GIT_SHA"

# IAM roles and the Django secret remain explicit manual bootstrap boundaries.
ecs_execution_role_arn = "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/yinon-status-page-prod-ecs-execution"
ecs_task_role_arn      = "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/yinon-status-page-prod-ecs-task"

runtime_secret_arns = {
  STATUS_PAGE_SECRET_KEY = "arn:aws:secretsmanager:il-central-1:REPLACE_WITH_ACCOUNT_ID:secret:yinon-status-page-prod-django-secret-REPLACE"
}

runtime_environment = {
  POSTGRES_PORT                    = "5432"
  POSTGRES_DB                      = "statuspage"
  POSTGRES_USER                    = "statuspage"
  REDIS_PORT                       = "6379"
  REDIS_SSL                        = "true"
  STATUS_PAGE_SITE_URL             = "http://status.yifilter.uk"
  STATUS_PAGE_CSRF_TRUSTED_ORIGINS = "http://status.yifilter.uk"
  STATUS_PAGE_TIME_ZONE            = "Asia/Jerusalem"
}