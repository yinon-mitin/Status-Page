# Copy to terraform.tfvars only after the network/data layer exists.
# Do not put secret values in this file; provide Secrets Manager ARNs instead.

aws_region  = "il-central-1"
project     = "yinon-status-page"
environment = "dev"
owner       = "yinon"
image_tag   = "sha-REPLACE_WITH_GIT_SHA"

# IAM roles are created and maintained manually. Terraform only consumes ARNs.
ecs_execution_role_arn = "arn:aws:iam::ACCOUNT_ID:role/yinon-status-page-prod-ecs-execution"
ecs_task_role_arn      = "arn:aws:iam::ACCOUNT_ID:role/yinon-status-page-prod-ecs-task"

create_services       = false
create_network        = false
app_private_subnet_ids = ["subnet-REPLACE_ME"]
ecs_security_group_id  = "sg-REPLACE_ME"
web_target_group_arn   = "arn:aws:elasticloadbalancing:il-central-1:ACCOUNT_ID:targetgroup/statuspage-web/REPLACE_ME"

runtime_environment = {
  POSTGRES_HOST             = "REPLACE_WITH_RDS_ENDPOINT"
  POSTGRES_PORT             = "5432"
  POSTGRES_DB               = "statuspage"
  POSTGRES_USER             = "statuspage"
  REDIS_HOST                = "REPLACE_WITH_REDIS_ENDPOINT"
  REDIS_PORT                = "6379"
  STATUS_PAGE_ALLOWED_HOSTS = "status.example.com"
  STATUS_PAGE_SITE_URL      = "https://status.example.com"
  STATUS_PAGE_TIME_ZONE     = "Asia/Jerusalem"
}

runtime_secret_arns = {
  STATUS_PAGE_SECRET_KEY = "arn:aws:secretsmanager:il-central-1:ACCOUNT_ID:secret:statuspage/dev/django-secret-REPLACE_ME"
  POSTGRES_PASSWORD      = "arn:aws:secretsmanager:il-central-1:ACCOUNT_ID:secret:statuspage/dev/postgres-password-REPLACE_ME"
}
